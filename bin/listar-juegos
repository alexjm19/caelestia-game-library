#!/usr/bin/python3 -I
"""Lista TODOS los juegos del PC en JSON para el plugin biblioteca-gaming de caelestia.
Solo lee archivos; no lanza nada.

Fuentes:
  - Steam: todas las bibliotecas de libraryfolders.vdf, portada de appcache/librarycache
  - Heroic (Epic/Legendary, GOG, Amazon/Nile): installed.json, portada de su caché de imágenes si existe
  - Lutris: pga.db, portada de ~/.local/share/lutris/coverart
  - Cualquier .desktop con Categories=Game (sistema, usuario y flatpak) que no sea un lanzador o herramienta

Salida: [{"id","name","source","cover","icon","launch":[...],"lastPlayed"}], jugados recientemente primero.
Uso: listar-juegos [--ocultar "Nombre 1, Nombre 2"]
"""
import configparser, glob, json, os, re, sqlite3, sys

HOME = os.path.expanduser("~")
STEAM = os.path.join(HOME, ".local/share/Steam")
STEAM_CACHE = os.path.join(STEAM, "appcache/librarycache")
NO_JUEGO_STEAM = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common|SteamVR|Steam Audio)|Redistributable", re.I)
# Lanzadores y herramientas con Categories=Game que no son juegos
NO_JUEGO_DESKTOP = re.compile(r"steam|heroic|lutris|goverlay|pupgui2|protonplus|protonup|vinegarhq\.vinegar|bottles|"
                              r"gamescope|mangohud|game-?devices|input-remapper|sc-controller|antimicrox|"
                              r"winetricks|protontricks|playonlinux|itch|minigalaxy|gamehub|cartridges", re.I)
DESKTOP_DIRS = [os.path.join(HOME, ".local/share/applications"), "/usr/share/applications",
                os.path.join(HOME, ".local/share/flatpak/exports/share/applications"),
                "/var/lib/flatpak/exports/share/applications"]
ICON_DIRS = [os.path.join(HOME, ".local/share/icons"), os.path.join(HOME, ".local/share/flatpak/exports/share/icons"),
             "/var/lib/flatpak/exports/share/icons", "/usr/share/icons/hicolor", "/usr/share/icons/breeze",
             "/usr/share/icons/Papirus", "/usr/share/pixmaps"]

def vdf(texto, clave):
    return re.findall(r'"%s"\s+"([^"]*)"' % re.escape(clave), texto)

def leer(ruta):
    try:
        return open(ruta, encoding="utf-8", errors="replace").read()
    except OSError:
        return ""

def steam_img(appid, *nombres):
    for n in nombres:
        hits = glob.glob(os.path.join(STEAM_CACHE, appid, n)) + glob.glob(os.path.join(STEAM_CACHE, appid, "*", n))
        if hits:
            return max(hits, key=os.path.getmtime)
    return ""

def icono(nombre):
    """Resuelve un nombre de icono del tema a un archivo (el más grande)."""
    if not nombre:
        return ""
    if nombre.startswith("/"):
        return nombre if os.path.exists(nombre) else ""
    mejor, tam = "", -1
    for base in ICON_DIRS:
        for f in glob.glob(os.path.join(base, "**", nombre + ".*"), recursive=True):
            if not f.endswith((".png", ".svg", ".jpg")):
                continue
            m = re.search(r"/(\d+)x\d+/", f)
            t = 10000 if f.endswith(".svg") else int(m.group(1)) if m else 0
            if t > tam:
                mejor, tam = f, t
        if mejor and tam >= 128:
            break
    return mejor

def steam():
    out, vistos = [], set()
    libs = {STEAM} | set(vdf(leer(os.path.join(STEAM, "steamapps/libraryfolders.vdf")), "path"))
    for lib in libs:
        for acf in glob.glob(os.path.join(lib, "steamapps", "appmanifest_*.acf")):
            t = leer(acf)
            appid, name = (vdf(t, "appid") or [""])[0], (vdf(t, "name") or [""])[0]
            if not appid or appid in vistos or not name or NO_JUEGO_STEAM.search(name):
                continue
            vistos.add(appid)
            out.append({"id": "steam:" + appid, "name": name, "source": "Steam",
                        "cover": steam_img(appid, "library_capsule.jpg", "library_600x900.jpg"),
                        "icon": steam_img(appid, "library_header.jpg", "header.jpg"),
                        "launch": ["steam", "steam://rungameid/" + appid],
                        "lastPlayed": int((vdf(t, "LastPlayed") or ["0"])[0] or 0)})
    return out

def heroic():
    out = []
    base = None
    for b in (os.path.join(HOME, ".config/heroic"), os.path.join(HOME, ".var/app/com.heroicgameslauncher.hgl/config/heroic")):
        if os.path.isdir(b):
            base = b
            break
    if not base:
        return out
    fuentes = [("legendary", os.path.join(base, "legendaryConfig/legendary/installed.json")),
               ("gog", os.path.join(base, "gog_store/installed.json")),
               ("nile", os.path.join(base, "nile_config/nile/installed.json"))]
    for runner, ruta in fuentes:
        try:
            datos = json.load(open(ruta))
        except (OSError, ValueError):
            continue
        items = datos.get("installed", datos) if isinstance(datos, dict) else datos
        items = items.values() if isinstance(items, dict) else items
        for g in items:
            if not isinstance(g, dict):
                continue
            app = g.get("app_name") or g.get("appName") or g.get("id") or ""
            name = g.get("title") or g.get("name") or app
            if not app:
                continue
            cover = ""
            for f in glob.glob(os.path.join(base, "images-cache", "*")):
                if app in os.path.basename(f):
                    cover = f
                    break
            out.append({"id": f"heroic:{runner}:{app}", "name": name, "source": "Heroic", "cover": cover, "icon": "",
                        "launch": ["xdg-open", f"heroic://launch/{runner}/{app}"], "lastPlayed": 0})
    return out

def lutris():
    out = []
    db = os.path.join(HOME, ".local/share/lutris/pga.db")
    if not os.path.exists(db):
        return out
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        filas = con.execute("select slug, name, coalesce(lastplayed,0) from games where installed = 1").fetchall()
    except sqlite3.Error:
        return out
    for slug, name, last in filas:
        cover = next((c for c in glob.glob(os.path.join(HOME, ".local/share/lutris/coverart", slug + ".*"))), "")
        out.append({"id": "lutris:" + slug, "name": name, "source": "Lutris", "cover": cover,
                    "icon": icono("lutris_" + slug), "launch": ["lutris", "lutris:rungame/" + slug],
                    "lastPlayed": int(last or 0)})
    return out

def escritorio(nombres_ya):
    out, vistos = [], set()
    for d in DESKTOP_DIRS:
        for f in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            fid = os.path.basename(f)
            if fid in vistos:
                continue
            vistos.add(fid)  # el de usuario tapa al del sistema, como en XDG
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read_string(leer(f))
                e = cp["Desktop Entry"]
            except (configparser.Error, KeyError):
                continue
            cats = e.get("Categories", "")
            if "Game" not in cats.split(";") or e.get("NoDisplay", "").lower() == "true" or e.get("Hidden", "").lower() == "true":
                continue
            exe = e.get("Exec", "")
            name = e.get("Name[es]") or e.get("Name", fid)
            if "steam://rungameid" in exe or "heroic://" in exe or "lutris:rungame" in exe or name.lower() in nombres_ya:
                continue  # ya lo da su tienda, con portada
            if NO_JUEGO_DESKTOP.search(fid):
                continue
            out.append({"id": "app:" + fid, "name": name, "source": "App", "cover": "",
                        "icon": icono(e.get("Icon", "")), "launch": ["gio", "launch", f], "lastPlayed": 0})
    return out

def main():
    ocultar = set()
    if "--ocultar" in sys.argv:
        i = sys.argv.index("--ocultar")
        if i + 1 < len(sys.argv):
            ocultar = {x.strip().lower() for x in sys.argv[i + 1].split(",") if x.strip()}
    juegos = steam() + heroic() + lutris()
    juegos += escritorio({j["name"].lower() for j in juegos})
    juegos = [j for j in juegos if j["name"].lower() not in ocultar]
    juegos.sort(key=lambda j: (-j["lastPlayed"], j["source"] == "App", j["name"].lower()))
    json.dump(juegos, sys.stdout, ensure_ascii=False)

if __name__ == "__main__":
    main()
