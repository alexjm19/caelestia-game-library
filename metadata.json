{
  "id": "biblioteca-gaming",
  "name": "Biblioteca gaming",
  "description": "Biblioteca gaming para la barra de Caelestia: Steam, Heroic, Lutris y apps .desktop, con portadas, favoritos y orden. Game library widget for the Caelestia bar: covers, favorites and sorting.",
  "version": "1.2.0",
  "type": "quickshell",
  "ui": "main.qml",
  "author": {
    "name": "alexjm19"
  },
  "license": "GPL-3.0-or-later",
  "barWidgets": [
    {
      "id": "bibliotecaGaming",
      "name": "Biblioteca gaming",
      "icon": "sports_esports",
      "defaultZone": "left",
      "component": "BarWidget.qml",
      "popout": "Popout.qml"
    }
  ],
  "settings": [
    {
      "id": "ocultar",
      "label": "Ocultar juegos separados por comas / Hide games (comma-separated)",
      "type": "text",
      "default": "",
      "placeholder": "KMines, KMahjongg"
    },
    {
      "id": "columnas",
      "label": "Columnas / Columns",
      "type": "number",
      "default": 5,
      "min": 3,
      "max": 8,
      "step": 1
    },
    {
      "id": "filas",
      "label": "Filas visibles, el resto con desplazamiento / Visible rows (the rest scroll)",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "id": "cerrarAlLanzar",
      "label": "Cerrar el panel al lanzar / Close panel on launch",
      "type": "toggle",
      "default": true
    },
    {
      "id": "idioma",
      "label": "Idioma / Language",
      "type": "enum",
      "default": "Auto",
      "options": [
        "Auto",
        "Español",
        "English"
      ]
    }
  ]
}
